# Plantilla de variables de entorno. Copiala a .env y rellena los valores.
# .env esta en .gitignore: NUNCA se versiona.
#
# Ninguna de estas variables es obligatoria para ejecutar el pipeline local.
# El proyecto funciona sin ninguna de ellas.

# --------------------------------------------------------------- servicio local
# Puerto del servicio HTTP. Cloud Run inyecta PORT automaticamente; en local
# 8080 es el valor por defecto.
PORT=8080

# Directorio del paquete de modelo que carga el servicio. Debe contener
# manifest.json, predictor.joblib, preprocessor.joblib, calibrator.joblib,
# feature_schema.json y policy.json.
PACKAGE_DIR=models/W30_T165

# Formato de los logs del servicio: json (recomendado en cloud) o text.
LOG_FORMAT=json

# ------------------------------------------------------------------- Kaggle
# NO se ponen aqui las credenciales. El cliente de Kaggle lee el token desde
#   %USERPROFILE%\.kaggle\kaggle.json   (Windows)
#   ~/.kaggle/kaggle.json               (Linux y macOS)
# Ese archivo es individual, va fuera del repositorio y requiere haber aceptado
# las reglas de la competencia. Ver: fraud-adaptive data instructions

# ---------------------------------------------------------------------- GCP
# Solo para el despliegue MANUAL del equipo. Este repositorio no ejecuta gcloud
# ni crea recursos; ver deploy/gcp_runbook.md.
# GCP_PROJECT_ID=<tu-project-id>
# GCP_REGION=us-central1
# ARTIFACT_REGISTRY_REPO=fraud-adaptive
