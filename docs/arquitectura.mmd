%% Arquitectura consolidada del sistema adaptativo de decision ante fraude.
%% Cinco componentes del enunciado: adquisicion/integracion, predictor, decision,
%% incertidumbre y accion; mas feedback, monitor y gates humanos.
%% Linea continua = implementado y verificado localmente.
%% Linea punteada = disponibilidad diferida o extension futura no implementada.
flowchart TB
    T["train_transaction<br/>(590k eventos, 182 dias)"] --> J["Left join 1:1 por TransactionID<br/>+ auditoria de invariancia"]
    I["train_identity<br/>(cobertura ~24%)"] --> J
    EXT["Adaptadores futuros de texto<br/>y senales de sesion<br/>NO IMPLEMENTADOS"] -.-> J

    J --> F["Features causales<br/>historial por proxy de tarjeta y dispositivo<br/>ventanas 1h / 24h / 7d, emitidas antes de actualizar estado"]
    F --> M["Predictor<br/>Logistica / Random Forest / LightGBM<br/>preprocesamiento ajustado DENTRO del fit"]
    M --> C["Calibrador Platt por version<br/>cola separada de 7 dias que el predictor no vio"]

    C --> D{"Politica economica<br/>minimiza costo esperado<br/>sujeta al cupo restante"}
    D --> A["APROBAR (simulado)"]
    D --> Q["REVISAR<br/>cupo duro 150/dia<br/>prioridad p x monto entre los ya llegados"]
    D --> B["BLOQUEAR (simulado)<br/>+ apelacion documentada"]

    Q --> OV["Overflow: sin cupo,<br/>la mas barata entre aprobar y bloquear"]
    Q --> H["Analista simulado<br/>r_H=0.90, f_H=0.02<br/>desenlace solo al madurar y"]

    A -.-> Y["Etiqueta confirmada<br/>disponible tras L=30 dias"]
    B -.-> LIM["Selective labels:<br/>limitacion declarada,<br/>el nucleo usa full-information"]

    F --> MON["Monitor de covariables<br/>KS/PSI diario + S1 por bloque"]
    C --> MON
    Y --> ERR["Brier individual emitido<br/>ADWIN por version"]
    ERR --> MON
    MON --> ALERT["Alerta con evidencia<br/>y sus dos relojes"]

    ALERT --> HUM{{"HUMANO autoriza<br/>el reentrenamiento"}}
    HUM --> FIT["Ajuste con ventana fija<br/>W30 / W60 / W90, cadencia 15 dias"]
    Y --> FIT
    FIT --> VAL["Orden estricto:<br/>predictor -> Platt -> reserva de politica -> validacion H"]
    VAL --> PROM{{"HUMANO aprueba<br/>la promocion"}}
    PROM --> M

    classDef humano fill:#fff3e0,stroke:#eb6834,stroke-width:2px;
    classDef futuro fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray:5 3;
    classDef accion fill:#e8f4fd,stroke:#2a78d6;
    class HUM,PROM humano;
    class EXT,LIM futuro;
    class A,Q,B,OV accion;
