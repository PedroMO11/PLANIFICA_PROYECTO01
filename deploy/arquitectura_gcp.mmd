%% Propuesta de despliegue en GCP.
%% Ningun recurso de este diagrama fue creado; el equipo ejecuta a mano los pasos
%% de deploy/gcp_runbook.md.
%% Linea continua = entregado y probado localmente.
%% Linea punteada = diseno futuro, sin implementacion ni codigo de integracion.
flowchart TB
    subgraph LOCAL["Entregado y verificado en local"]
        PKG["Paquete versionado<br/>predictor + preprocesador + Platt + politica + manifest"]
        IMG["Imagen Docker<br/>linux/amd64, escucha en $PORT"]
        RPL["replay.py + ledger SQLite<br/>autoridad del cupo y de las decisiones"]
        RUN["Runbook manual<br/>deploy/gcp_runbook.md"]
    end

    PKG --> IMG
    IMG --> MAN{{"Equipo: build, push y deploy manual"}}
    RUN --> MAN

    MAN --> AR["Artifact Registry<br/>imagen fijada por digest"]
    AR --> CR["Cloud Run<br/>inferencia HTTP, privado,<br/>min 0 / max 1, concurrencia 1"]
    RPL -->|"cliente local, cupo autoritativo"| CR

    GCS["Cloud Storage<br/>paquetes y evidencia"] -.-> JOB["Cloud Run Jobs<br/>o Vertex AI Pipelines"]
    PS["Pub/Sub<br/>stream de transacciones"] -.-> CR
    CR -.-> FS["Firestore<br/>ledger y cupo distribuidos"]
    CR -.-> BQ["BigQuery<br/>cohortes y metricas tardias"]
    CR -.-> LOG["Cloud Logging / Monitoring"]
    BQ -.-> LOG

    SCH["Cloud Scheduler<br/>solicitud cada 15 dias"] -.-> HUM{{"Aprobacion humana<br/>del reentrenamiento"}}
    LOG -.-> HUM
    HUM -.-> JOB
    JOB -.-> VALID["Validacion temporal separada<br/>predictor, Platt y H"]
    VALID -.-> HPROM{{"Aprobacion humana<br/>de la promocion"}}
    HPROM -.-> CR

    GCS -.-> VEP["Vertex AI Endpoints<br/>alternativa descartada para la demo"]

    classDef humano fill:#fff3e0,stroke:#eb6834,stroke-width:2px;
    classDef futuro fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray:5 3;
    classDef local fill:#e8f7f0,stroke:#1baf7a;
    class MAN,HUM,HPROM humano;
    class GCS,PS,FS,BQ,LOG,JOB,SCH,VALID,VEP futuro;
    class PKG,IMG,RPL,RUN local;
