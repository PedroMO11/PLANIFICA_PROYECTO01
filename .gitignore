# ---------------------------------------------------------------- datos crudos
# No se versionan: IEEE-CIS exige aceptar las reglas de la competencia y un token
# individual. Se reconstruyen con `fraud-adaptive data instructions` (datos reales)
# o `fraud-adaptive data surrogate` (sustituto sintetico).
/ieee-fraud-detection
/jigsaw-unintended-bias-in-toxicity-classification
/diabetes+130-us+hospitals+for+years+1999-2008
/cd_bench
cd_bench.zip

# ------------------------------------------------------- artefactos regenerables
# Todo esto se reproduce con `fraud-adaptive all`. Se excluye por tamano, no por
# ser prescindible: el manifest de entrega registra sus hashes.
/data/processed/
/runs/
/models/

